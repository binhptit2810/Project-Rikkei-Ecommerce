# =============================================================================
# Root .env.example — E-commerce Platform (TSK-D13-DHA)
# Phụ trách: Đỗ Hoàng Anh (MSV: B24DTCN300)
# Sao chép file này thành .env và điều chỉnh thông số khi cần:
# cp .env.example .env
# KHÔNG commit file .env vào Git
# =============================================================================

# =============================================================================
# Nhóm 1: MySQL 8.0 Database
# =============================================================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=password
MYSQL_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=password

# =============================================================================
# Nhóm 2: Redis 7 Cache & Rate Limiting & Session Store
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Nhóm 3: JWT Authentication & Security
# =============================================================================
# Chuỗi secret tối thiểu 256-bit (>= 32 ký tự) cho HMAC-SHA256
JWT_SECRET=ecommerce-platform-default-dev-secret-change-this-in-production-2024-secure-256bit
# Access Token: 15 phút = 900.000 ms
JWT_EXPIRATION=900000
JWT_EXPIRATION_MS=900000
# Refresh Token: 7 ngày = 604.800.000 ms
JWT_REFRESH_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION_MS=604800000
# Danh sách CORS origins cho phép
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# =============================================================================
# Nhóm 4: Google Gemini AI Chatbot (Spring AI OpenAI-compatible Client)
# =============================================================================
GEMINI_API_KEY=mock-gemini-key-placeholder
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHAT_RATE_LIMIT_PER_MINUTE=15

# =============================================================================
# Nhóm 5: Cổng thanh toán VNPay Sandbox
# =============================================================================
VNPAY_TMN_CODE=2QXUI4J4
VNPAY_HASH_SECRET=RAIQUIBGCARJHNLKZCPGUCUMRHQKGZDF
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders/vnpay-return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay

# =============================================================================
# Nhóm 6: Email SMTP & OTP Verification (Brevo / Gmail)
# =============================================================================
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@rikkei-shop.me
MAIL_FROM_NAME=Rikkei Store
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_DEV_FALLBACK_ENABLED=true
OTP_HMAC_SECRET=ecommerce-default-otp-hmac-secret-change-in-production-2024

# =============================================================================
# Nhóm 7: Ports & Frontend Nginx Reverse Proxy
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=8080
VITE_API_BASE_URL=/api/v1
SPRING_PROFILES_ACTIVE=docker
