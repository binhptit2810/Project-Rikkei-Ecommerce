# =============================================================================
# Root .env.example — E-commerce Platform
# Sao chép file này thành .env và điều chỉnh mật khẩu nếu cần
# KHÔNG commit file .env vào Git
# =============================================================================

# ---- MySQL Database ----
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass_123

# ---- Backend (Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=ecommerce_pass_123

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Ports (cho Docker Compose) ----
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306
