# =============================================================================
# Root .env.example — E-commerce Platform
# Sao chép file này thành .env và điều chỉnh mật khẩu nếu cần
# KHÔNG commit file .env vào Git
# =============================================================================

# ---- MySQL Database ----
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass_123

# ---- Backend (Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=ecommerce_pass_123

# ---- JWT Authentication ----
# Bắt buộc >= 32 ký tự (256-bit) cho HMAC-SHA256
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars
# Access Token: 15 phút (900000ms)
JWT_EXPIRATION=900000
# Refresh Token: 7 ngày (604800000ms)
JWT_REFRESH_EXPIRATION=604800000

# ---- Redis Cache & Session Store ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Resend SMTP & OTP Secret (TSK-D10-CCT) ----
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=${RESEND_API_KEY}
# Development: dùng onboarding@resend.dev (chỉ gửi tới email chủ tài khoản Resend)
# Production: dùng noreply@mail.rikkei-shop.me (sau khi verify domain mail.rikkei-shop.me trên Resend)
MAIL_FROM=noreply@mail.rikkei-shop.me
MAIL_SMTP_SSL_ENABLE=true
MAIL_SMTP_STARTTLS_ENABLE=false
OTP_HMAC_SECRET=your_random_otp_hmac_secret_at_least_32_chars

# ---- CORS (Danh sách origin phân tách bởi dấu phẩy) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:*

# ---- Frontend ----
# API prefix thống nhất theo docs/API.md
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Ports (cho Docker Compose) ----
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
