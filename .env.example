# =============================================================================
# Root .env.example — E-commerce Platform
# Sao chép file này thành .env và điều chỉnh mật khẩu nếu cần
# KHÔNG commit file .env vào Git
# =============================================================================

# ---- MySQL Database ----
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass_123

# ---- Backend (Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=ecommerce_pass_123

# ---- JWT Authentication ----
# Bắt buộc >= 32 ký tự (256-bit) cho HMAC-SHA256
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars
# Access Token: 15 phút (900000ms)
JWT_EXPIRATION=900000
# Refresh Token: 7 ngày (604800000ms)
JWT_REFRESH_EXPIRATION=604800000

# ---- Redis Cache & Session Store ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Cấu hình Email SMTP & Xác thực OTP (TSK-D10-CCT) ----
# LƯU Ý CHO THÀNH VIÊN TRONG NHÓM KHI CLONE DỰ ÁN VỀ:
# Có 2 cách để gửi email thật về hòm thư mà KHÔNG bị Google chặn/khóa giới hạn gửi:
#
# Cách 1 (Khuyên dùng cho Gmail cá nhân): Mỗi thành viên tự điền tài khoản Gmail riêng của mình
#   - Bật Xác minh 2 bước trong tài khoản Google -> Tạo "Mật khẩu ứng dụng" (App Password) 16 ký tự.
#   - Điền email và mật khẩu ứng dụng đó vào 3 dòng bên dưới:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Rikkei Store
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
#
# Cách 2 (Dùng chung cho cả nhóm không giới hạn - Brevo / Sendinblue):
#   - Đăng ký miễn phí tại https://brevo.com (miễn phí 300 email/ngày vĩnh viễn, không bị Google quét spam/khóa IP)
#   - MAIL_HOST=smtp-relay.brevo.com
#   - MAIL_PORT=587
#   - MAIL_USERNAME=email_tai_khoan_brevo
#   - MAIL_PASSWORD=smtp_key_brevo_cap
#
# Bật tính năng Fallback: nếu mạng lỗi hoặc email quá hạn ngạch, mã OTP sẽ tự in ra console Docker để test tiếp
MAIL_DEV_FALLBACK_ENABLED=true
OTP_HMAC_SECRET=k9X2mP5vL8qR3wY6zF1nH4bC7jD0sT2x

# ---- Cổng thanh toán VNPay Sandbox (TSK-VNPAY-DTB) ----
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=2QXUI4J4
VNPAY_HASH_SECRET=RAIQUIBGCARJHNLKZCPGUCUMRHQKGZDF
VNPAY_RETURN_URL=http://localhost:3000/orders/vnpay-return

# ---- Google Gemini AI Chatbot (TSK-D11-CCT) ----
GEMINI_API_KEY=API_KEY_BAN_VUA_TAO
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- CORS (Danh sách origin phân tách bởi dấu phẩy) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:*

# ---- Frontend ----
# API prefix thống nhất theo docs/API.md
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Ports (cho Docker Compose) ----
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
