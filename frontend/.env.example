# =============================================================================
# Frontend .env.example
# Sao chép thành .env hoặc .env.local để cấu hình
# =============================================================================

# URL base của backend API (/api/v1 cho reverse proxy Docker Nginx hoặc http://localhost:8080/api/v1 khi chạy local)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Tên ứng dụng (hiển thị ở tab trình duyệt)
VITE_APP_NAME=E-commerce Platform

# Cấu hình Auth0 Single Page Application (Google Login)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
